# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Optional Telegram provider. If this is unset, only iMessage is registered.
TELEGRAM_BOT_TOKEN=

# OpenRouter API key (OpenAI-compatible gateway used by the agent runtime).
# Default model: openai/gpt-oss-120b:free (override with BTL_MODEL).
BTL_API_KEY=

# Exa Search API for live web context around earthquake advisories and reports.
EXA_API_KEY=
